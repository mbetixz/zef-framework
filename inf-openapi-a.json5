{
  "$schema": "https://raw.githubusercontent.com/infection/infection/0.30.0/resources/schema.json",
  "source": {
    "directories": [
      "src/Domain/OpenApi",
      "src/Application/OpenApi"
    ]
  },
  "timeout": 30,
  "logs": {
    "text": "build/infection-oa-a.log",
    "summary": "build/infection-summary-oa-a.json"
  },
  "mutators": {
    "@default": true
  }
}
